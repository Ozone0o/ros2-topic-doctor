<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roscope</name>
  <version>0.2.0</version>
  <description>Modern ROS 2 observability and diagnostic toolkit for communication health.</description>

  <maintainer email="maintainers@roscope.dev">Roscope maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <tool_depend>rosidl_default_runtime</tool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
