<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_topic_doctor</name>
  <version>0.1.0</version>
  <description>Diagnose ROS2 topic status: rate, QoS, freshness in one command.</description>

  <maintainer email="dev@example.com">ROS2 Developer</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>

  <tool_depend>rosidl_default_runtime</tool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
